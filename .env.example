# ============================================================
# Product Second Brain — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env or any token files to version control.
# ============================================================

# === Identity (who the harness works for) ===
# Used for doc-sharing fallbacks and "is this assigned to me?" matching.
# WORK_DOMAIN: your Google Workspace domain — docs get restricted/shared to it.
OWNER_EMAIL=said.iskandar@gmail.com

CATALYZE_EMAIL=said@catalyze.id
CATALYZE_DOMAIN=catalyze.id

#SAMUDERA_EMAIL=said@samudera.id
#SAMUDERA_DOMAIN=samudera.id
# OWNER_NAME_TOKENS: comma-separated name variants meeting tools may use for you.
OWNER_NAME_TOKENS=said, said iskandar
# OWNER_SLACK_ID: your Slack member ID (Profile → three dots → Copy member ID).
OWNER_SLACK_ID=<SLACK_ID>

# === OpenAI (optional, for fallback LLM calls) ===
OPENAI_API_KEY=sk-proj-...

# === Slack ===
# Get from: https://api.slack.com/apps → Your App → OAuth & Permissions
# Required scopes: channels:read, channels:history, chat:write, groups:read,
#                  groups:history, im:read, im:history, users:read, files:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...        # Optional, needed for some user-context reads

# === Fathom (meeting transcripts) ===
# Get from: https://fathom.video/settings/account/integrations
FATHOM_API_KEY=your-fathom-api-key

# === Mixpanel (product analytics) ===
# Get from: https://mixpanel.com → Settings → Project Settings
MIXPANEL_PROJECT_TOKEN=your-project-token
MIXPANEL_PROJECT_ID=your-numeric-project-id
MIXPANEL_API_SECRET=your-api-secret
# Optional: service account credentials (recommended for production)
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=

# === Figma ===
# Get from: https://www.figma.com/settings → Personal Access Tokens
FIGMA_ACCESS_TOKEN=your-figma-pat

# === ClickUp (task management) ===
# Get from: https://app.clickup.com/settings → Apps → API Token
CLICKUP_ACCESS_TOKEN=your-clickup-token

# === Telegram (news briefings + notifications) ===
# Get bot token from: https://t.me/BotFather
# Get chat ID from: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === DeepSeek (LLM via news-intelligence and other skills) ===
DEEPSEEK_API_KEY=your-deepseek-api-key

# === Coding Agent (OpenCode-backed coding jobs) ===
# Repos this agent can work on: each child dir must be a git repo.
# VPS default is /home/ubuntu/projects (the shared VPS root).
CODING_PROJECTS_ROOT=/home/ubuntu/projects
# Per-job git worktrees live here (gitignored by the repos themselves).
CODING_WORKTREES_ROOT=/home/ubuntu/projects/.worktrees
# Path to the opencode binary (VPS: /home/ubuntu/.opencode/bin/opencode).
CODING_OPENCODE_BIN=opencode
# per-job (default, recommended) | single (talk to one always-on opencode serve)
CODING_OPENCODE_MODE=per-job
# Single-server connection settings (only used when CODING_OPENCODE_MODE=single).
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Per-job server ports (unique per job).
CODING_PORT_RANGE=4100-4199
# TTL before finished jobs get their worktree/server reaped (hours) + preview lifetime (s).
CODING_JOB_TTL_HOURS=72
CODING_PREVIEW_TTL_SECS=1800
# Commit identity used for the approved "coding(...)" commits.
# CODING_GIT_NAME=Second Brain Coding Agent
# CODING_GIT_EMAIL=said@catalyze.id

# ============================================================
# Google OAuth tokens are NOT stored here.
# They live as token.json files inside each skill directory
# and are generated automatically on first run.
#
# Required files (generate via first-run OAuth flow):
#   .agent/skills/[your-connector]/credentials.json  ← from Google Cloud Console
#   .agent/skills/[your-connector]/token.json         ← auto-generated on first run
#
# See docs/SETUP.md → "Google OAuth Setup" for full instructions.
# ============================================================
